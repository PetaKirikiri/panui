# Copy to `.env` or pull from Vercel (`npm run vercel:env:pull` writes `.env.local`; Vite loads it over `.env`).
# Sanity check: `npm run test:supabase`
# Login uses VITE_SUPABASE_ANON_KEY = Supabase Dashboard → Project Settings → API → anon public.
# (Edge Function “Secrets” are separate — they do not substitute for the anon key in the browser.)

# When opening via Akomanga dev (localhost:5174/panui/... proxy): npm run dev:shell or VITE_APP_BASE=/panui/
# Vercel (Pānui project): set VITE_APP_BASE=/panui/ on Production and Preview builds.

# Products menu: when this deployment has its own *.vercel.app host, set shell origin so links hit Akomanga.
# VITE_ECOSYSTEM_SHELL_ORIGIN=https://akomanga.vercel.app

# Word metadata: set to 1 or true to skip all persist (for testing)
# VITE_WORD_METADATA_DRY_RUN=1

# --- OpenAI / Edge (same pattern as Pūrākau) ---
# API keys must NOT go in Vite env — only Supabase Edge secrets.
# Push key from SmarterSubs or ../Pūrākau `.env` (VITE_OPENAI_API_KEY or OPENAI_API_KEY):
#   npx supabase login
#   npm run secrets:openai:from-smartersubs
# Also sets OPENAI_SUGGEST_MODEL / OPENAI_MATCH_MODEL when present there.
# Deploy matcher: npm run functions:deploy:match-te-aka-sense
# Manual: supabase secrets set OPENAI_API_KEY=sk-... --project-ref <ref>

# Supabase project ref (from Dashboard URL or Project Settings; used for Drizzle DB URL if DATABASE_URL unset)
SUPABASE_PROJECT_REF=your-project-ref
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Local chapter import (bypasses RLS): npm run import:chapter -- <titleId> <versionId> <chapterNum> paste.txt
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret
# Dev only: same-origin Supabase via Vite proxy (for embedded previews that block *.supabase.co).
# Requires Node to reach your project URL; if you see proxy/500 errors, omit this and use Chrome/Safari instead.
# VITE_SUPABASE_USE_DEV_PROXY=1
SUPABASE_DB_PASSWORD=your-db-password
# Optional: full connection string from Supabase Dashboard > Settings > Database (use if migrate script fails)
# DATABASE_URL=postgresql://postgres.[PROJECT]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# Cloudflare R2 (for media uploads)
# Account Id - from dashboard
CLOUDFLARE_ACCOUNT_ID=
# S3 API - Access Key ID and Secret Access Key from R2 > Manage R2 API Tokens
CLOUDFLARE_S3_ACCESS_KEY_ID=
CLOUDFLARE_S3_SECRET_ACCESS_KEY=
# Bucket name and public URL (e.g. https://pub-xxx.r2.dev) - also set as Supabase secrets
CLOUDFLARE_R2_BUCKET_NAME=
CLOUDFLARE_R2_PUBLIC_URL=
